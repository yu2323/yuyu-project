+
+function normalizeNarrativeRepeatCandidate(value) {
+    return String(value || '')
+        .replace(/[\s，,。！？!?；;：:、…—“”「」『』‘’'"（）()【】\[\]]+/gu, '');
+}
+
+function isSubsequenceText(shorter, longer) {
+    if (!shorter || !longer || shorter.length > longer.length) return false;
+    let i = 0;
+    for (let j = 0; j < longer.length && i < shorter.length; j += 1) {
+        if (shorter[i] === longer[j]) i += 1;
+    }
+    return i === shorter.length;
+}
+
+function looksLikeAdjacentDeletionVariant(leftSentence, rightSentence) {
+    const left = normalizeNarrativeRepeatCandidate(leftSentence);
+    const right = normalizeNarrativeRepeatCandidate(rightSentence);
+    if (left.length < 24 || right.length < 24) return false;
+
+    const shorter = left.length <= right.length ? left : right;
+    const longer = left.length <= right.length ? right : left;
+    const diff = longer.length - shorter.length;
+    const ratio = shorter.length / longer.length;
+
+    // v7.0.30 deliberately does NOT use semantic/fuzzy similarity. It only accepts
+    // a near-copy that can be explained by a small contiguous/dispersed deletion.
+    if (diff < 1 || diff > 16 || ratio < 0.82) return false;
+    if (left.slice(0, 4) !== right.slice(0, 4)) return false;
+    if (left.slice(-10) !== right.slice(-10)) return false;
+    return isSubsequenceText(shorter, longer);
+}
+
+/**
+ * v7.0.30: collapse a narration sentence replay where AI cleanup removes only a
+ * small phrase and accidentally leaves both the original sentence and its edited
+ * copy across adjacent paragraphs.
+ *
+ * Example:
+ *   ...他的心，他的灵魂，他所有的爱与执念，早就在两年前那个春日里，完完整整地刻在了虞昭的名字上。
+ *
+ *   他的心，他所有的爱与执念，早就在两年前那个春日里，完完整整地刻在了虞昭的名字上。B...
+ *
+ * Safety boundaries:
+ * - narration only; dialogue is preserved byte-for-byte by transformOutsideDialogue
+ * - only the last sentence before a blank-line paragraph break vs the first sentence after it
+ * - both candidates >= 24 normalized chars
+ * - same first 4 + last 10 normalized chars
+ * - only 1~16 normalized chars may differ, with >= 82% length retention
+ * - shorter form must be an exact subsequence of the longer form
+ * - no embeddings, edit-distance fuzz, synonym matching, or semantic similarity
+ *
+ * The later sentence is kept because it is the post-rewrite copy; only the earlier
+ * duplicate sentence is removed. Other text in the previous paragraph is preserved.
+ */
+export function cleanupNarrativeAdjacentDeletionVariant(sourceText) {
+    return transformOutsideDialogue(sourceText, (span) => {
+        let output = String(span || '');
+        if (!output) return output;
+
+        const paragraphBreak = /\r?\n[ \t]*\r?\n+/gu;
+        for (let pass = 0; pass < 3; pass += 1) {
+            let changed = false;
+            let rebuilt = '';
+            let cursor = 0;
+
+            for (const match of output.matchAll(paragraphBreak)) {
+                const breakStart = Number(match.index) || 0;
+                const breakEnd = breakStart + match[0].length;
+                const before = output.slice(cursor, breakStart);
+                const afterAll = output.slice(breakEnd);
+
+                const leftTail = before.match(/([^。！？!?；;\r\n]{1,180}[。！？!?])\s*$/u);
+                const rightHead = afterAll.match(/^\s*([^。！？!?；;\r\n]{1,180}[。！？!?])/u);
+
+                if (leftTail && rightHead && looksLikeAdjacentDeletionVariant(leftTail[1], rightHead[1])) {
+                    const cutAt = before.length - leftTail[0].length;
+                    rebuilt += before.slice(0, cutAt).replace(/[ \t]+$/u, '');
+                    rebuilt += match[0];
+                    cursor = breakEnd;
+                    changed = true;
+                    continue;
+                }
+
+                rebuilt += output.slice(cursor, breakEnd);
+                cursor = breakEnd;
+            }
+
+            rebuilt += output.slice(cursor);
+            if (!changed || rebuilt === output) break;
+            output = rebuilt;
+        }
+        return output;
+    });
+}
